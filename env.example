# Firebase Configuration
# Copy this file to .env and fill in your Firebase credentials
# Get these from: Firebase Console > Project Settings > Your Apps

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:YOUR_ID:web:YOUR_HASH

# Push Notifications (Get from: Firebase Console > Messaging > Web Configuration)
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key_here

# App Config
VITE_APP_NAME=GPOS
VITE_APP_VERSION=2.0.0
VITE_APP_ENV=development
